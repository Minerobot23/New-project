# Copy to .env.local for local development. Never commit real values.
# All of these are server-only (no NEXT_PUBLIC_ prefix) and are never sent to the browser.

# Resend API key (https://resend.com/api-keys). Sending access only is sufficient.
RESEND_API_KEY=

# Verified sender for website notifications. The domain must be verified in Resend.
# Example: Fluxline Website <notifications@fluxlinesolutions.com>
LEAD_FROM_EMAIL=

# Where call requests are delivered. Comma-separate for multiple recipients.
# Production: cristhian@fluxlinesolutions.com
LEAD_NOTIFICATION_EMAIL=

# Optional. IANA time zone used for the "Submitted" time in notifications (default: UTC).
# Example: America/New_York
LEAD_NOTIFICATION_TIMEZONE=

# Optional. Search engine verification via HTML meta tag (DNS TXT verification is preferred; see docs/SEARCH-CONSOLE.md).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Pricing, payments, and client portal (see docs/BILLING-SETUP.md)
# ---------------------------------------------------------------------------

# Postgres connection string (for example Neon, added from the Vercel Marketplace). Required in production.
# Leave empty locally to use an embedded database in ./.data (development only).
DATABASE_URL=

# Random secret, at least 32 characters, used to hash IP addresses on agreement records.
# Generate with: openssl rand -base64 48
AUTH_SECRET=

# Public base URL for links in emails and Stripe redirects. Production: https://fluxlinesolutions.com
APP_URL=

# Comma-separated emails allowed into /admin. Removing an address revokes access on the next request.
ADMIN_EMAILS=

# Stripe secret key. Use a TEST key (sk_test_... or a restricted rk_test_...) until live payments are approved.
STRIPE_SECRET_KEY=

# Signing secret for the /api/stripe/webhook endpoint (whsec_...). From Stripe Dashboard > Developers > Webhooks,
# or printed by `stripe listen` for local testing.
STRIPE_WEBHOOK_SECRET=

# Optional. Customer Portal configuration id printed by `npm run stripe:setup` (bpc_...).
STRIPE_PORTAL_CONFIGURATION=

# Live charges stay off unless this is exactly "true" AND the service agreement is marked approved.
# Leave unset until you've reviewed the agreement and explicitly approved going live.
BILLING_LIVE_ENABLED=

# Email delivery for billing and portal notifications: log (default, nothing is sent), sandbox, or live.
# sandbox sends every message to EMAIL_SANDBOX_TO instead of the customer. Use live only once live payments are approved.
EMAIL_DELIVERY=
EMAIL_SANDBOX_TO=

# Secret Vercel Cron sends to /api/cron/reminders. Generate with: openssl rand -hex 32
CRON_SECRET=
